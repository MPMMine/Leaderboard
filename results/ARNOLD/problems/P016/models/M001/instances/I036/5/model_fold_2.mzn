constraint forall(a in 1..192)(-total_earn*buy[a] <= -buy[a]);
constraint forall(a in 1..192)(-total_earn*buy_price[a] <= -sell[a]);
constraint forall(a in 1..192)(-total_earn*sell[a] <= -sell[a]);
constraint forall(a in 1..192)(-total_earn*buy_price[a] <= -charge[a]);
constraint forall(a in 1..192)(-total_earn*cost[a] <= -charge[a]);
constraint forall(a in 1..192)(-total_earn*buy_price[a] <= -discharge[a]);
constraint forall(a in 1..192)(-total_earn*buy_price[a] <= -cost[a]);
constraint forall(a in 1..192)(-total_earn*cost[a] <= -cost[a]);
constraint forall(a in 1..192)(-total_earn*sell[a] <= -earn[a]);
constraint forall(a in 1..192)(-total_earn*consumption[a] <= -earn[a]);
constraint forall(a in 1..192)(-total_earn*buy_price[a] <= -earn[a]);
constraint (-total_earn*total_earn <= -total_cost);
constraint forall(a in 1..192) ( 0 <= production[a]);
constraint forall(a in 1..192) ( 0 <= buy[a]);
constraint forall(a in 1..192) ( 0 <= sell[a]);
constraint forall(a in 1..192) ( 0 <= charge[a]);
constraint forall(a in 1..192) ( 0 <= discharge[a]);
constraint forall(a in 1..192) ( 0 <= soc[a]);
constraint forall(a in 1..192) ( 0 <= cost[a]);
constraint forall(a in 1..192) ( 0 <= earn[a]);
constraint  ( 0 <= total_cost);
constraint  ( 0 <= total_earn);
solve satisfy;
% Added in postprocessing to handle set variables/parameters:
include "globals.mzn";
set of 1..192: periods;
constraint link_set_to_booleans(periods, array1d(1..192, [b == 1 | b in periods_]));

