constraint (sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -total_weight);
constraint (sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -storage_cap);
constraint (sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -holding_cost);
constraint forall(b in 1..5)(sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -initial_stock[b]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -buy[b,c]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -amount[b,c]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5,c in 1..6) (-amount[b,c]*stock[b,c]) <= -stock[b,c]);
constraint forall(c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -num_ingredients);
constraint forall(c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -num_nutrients);
constraint forall(c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -num_periods);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -Grains_[b]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -cost[b,c]);
constraint forall(a in 1..4,b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -comp[b,a]);
constraint forall(a in 1..4,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -min_req[a]);
constraint forall(a in 1..4,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -max_req[a]);
constraint (sum(b in 1..5,c in 1..6) (-stock[b,c]*stock[b,c]) <= -total_weight);
constraint (sum(b in 1..5,c in 1..6) (-stock[b,c]*stock[b,c]) <= -storage_cap);
constraint forall(c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -holding_cost);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -initial_stock[b]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -buy[b,c]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -amount[b,c]);
constraint forall(b in 1..5,c in 1..6)(sum(c in 1..6) (-stock[b,c]*stock[b,c]) <= -stock[b,c]);
constraint forall(b in 1..5,c in 1..6)(sum(b in 1..5) (-stock[b,c]*stock[b,c]) <= -stock[b,c]);
constraint forall(b in 1..5,c in 1..6) ( 0 <= buy[b,c]);
constraint forall(b in 1..5,c in 1..6) ( 0 <= amount[b,c]);
constraint forall(b in 1..5,c in 1..6) ( 0 <= stock[b,c]);
solve satisfy;
% Added in postprocessing to handle set variables/parameters:
include "globals.mzn";
set of 1..5: Grains;
constraint link_set_to_booleans(Grains, array1d(1..5, [b == 1 | b in Grains_]));

